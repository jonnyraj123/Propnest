        android:strokeColor="#9AA1B5"
        android:strokeWidth="3"
        android:strokeLineCap="round" />

    <!-- Cap and base. -->
    <path android:pathData="M42,32 H66 V38 H42 Z" android:fillColor="#9AA1B5" />
    <path android:pathData="M36,70 H72 V77 H36 Z" android:fillColor="#9AA1B5" />

